{
  "name": "@slogan/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "APP_NAME=slogan-api nest start --watch",
    "start": "APP_NAME=slogan-api node dist/main.js",
    "start:room-speech-worker": "APP_NAME=slogan-room-speech-worker node dist/workers/room-speech/main.js",
    "dev:room-speech-worker": "APP_NAME=slogan-room-speech-worker nest start --watch --entryFile workers/room-speech/main",
    "start:operations-worker": "APP_NAME=slogan-operations-worker node dist/workers/operations/main.js",
    "dev:operations-worker": "APP_NAME=slogan-operations-worker nest start --watch --entryFile workers/operations/main",
    "build": "prisma generate && nest build",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:test:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "db:test:migrate": "DATABASE_URL=postgresql://slogan:slogan@127.0.0.1:54329/slogan_test prisma migrate deploy",
    "db:test:down": "docker compose -f docker-compose.test.yml down --volumes",
    "backoffice:bootstrap": "pnpm build && node dist/scripts/bootstrap-backoffice.js",
    "backup:postgres": "node scripts/backup-postgres.mjs",
    "restore:postgres": "node scripts/restore-postgres.mjs",
    "recovery:check": "node scripts/check-recovery-invariants.mjs",
    "lint": "eslint src api test --max-warnings=0",
    "openapi:generate": "pnpm build && node dist/scripts/generate-openapi.js",
    "openapi:check": "pnpm build && node dist/scripts/generate-openapi.js --check",
    "test": "pnpm test:unit && pnpm test:integration && pnpm test:e2e",
    "test:unit": "prisma generate && APP_NAME=slogan-api-test node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand test/unit test/bootstrap.spec.ts src/modules",
    "test:integration": "pnpm db:test:migrate && prisma generate && DATABASE_URL=postgresql://slogan:slogan@127.0.0.1:54329/slogan_test APP_NAME=slogan-api-test node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand test/integration",
    "test:e2e": "prisma generate && APP_NAME=slogan-api-test node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand test/e2e",
    "test:runtime": "pnpm build && pnpm db:test:migrate && prisma generate && DATABASE_URL=postgresql://slogan:slogan@127.0.0.1:54329/slogan_test APP_NAME=slogan-api-test node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand test/runtime",
    "verify": "pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test:integration && pnpm test:e2e && pnpm build && pnpm openapi:check",
    "typecheck": "tsc --noEmit",
    "start:auth-mail-worker": "APP_NAME=slogan-auth-mail-worker node dist/workers/auth-mail/main.js",
    "dev:auth-mail-worker": "APP_NAME=slogan-auth-mail-worker nest start --watch --entryFile workers/auth-mail/main",
    "preview:accounts": "node dist/scripts/preview-accounts.js",
    "start:realtime-worker": "APP_NAME=slogan-realtime-worker node dist/workers/realtime/main.js"
  },
  "dependencies": {
    "@livekit/rtc-node": "1.0.0",
    "@nestjs/common": "12.0.1",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "12.0.1",
    "@nestjs/jwt": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@nestjs/swagger": "12.0.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@vercel/queue": "0.8.0",
    "bullmq": "6.3.4",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "express": "5.2.1",
    "google-auth-library": "^11.1.0",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "libphonenumber-js": "^1.13.12",
    "livekit-server-sdk": "2.19.0",
    "nodemailer": "10.0.10",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "rate-limiter-flexible": "11.2.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "yaml": "2.9.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "10.1.1",
    "@nestjs/cli": "12.0.0",
    "@nestjs/testing": "12.0.1",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/node": "24.13.3",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/smtp-server": "3.5.13",
    "@types/supertest": "7.2.1",
    "jest": "29.7.0",
    "jest-mock": "29.7.0",
    "openapi-types": "12.1.3",
    "prisma": "7.10.0",
    "smtp-server": "3.19.13",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "typescript": "6.0.3"
  }
}
