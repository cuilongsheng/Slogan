APP_NAME=slogan-api
APP_PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://slogan:slogan@127.0.0.1:5432/slogan
CORS_ALLOWED_ORIGINS=http://localhost:5173
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_ISSUER=slogan-api
JWT_AUDIENCE=slogan-clients
REFRESH_TOKEN_PEPPER=replace-with-a-different-32-character-secret
REFRESH_TOKEN_TTL_SECONDS=2592000
ROOM_PASSWORD_PEPPER=replace-with-another-random-32-character-secret
ROOM_RULES_VERSION=2026-09-v1
ROOM_SHARE_BASE_URL=https://app.example.com/rooms/
AUTH_RATE_LIMIT_POINTS=10
AUTH_RATE_LIMIT_DURATION_SECONDS=60
OAUTH_HTTP_TIMEOUT_MS=5000
PHONE_AUTH_ENABLED=false
ACCOUNT_LIFECYCLE_ENABLED=false
PHONE_IDENTITY_HASH_VERSION=v1
PHONE_IDENTITY_PEPPER=
PHONE_OTP_CODE_PEPPER=
PHONE_OTP_TTL_SECONDS=300
PHONE_OTP_MAX_ATTEMPTS=5
PHONE_OTP_RESEND_COOLDOWN_SECONDS=60
PHONE_OTP_RATE_LIMIT_POINTS=5
PHONE_OTP_RATE_LIMIT_DURATION_SECONDS=3600
PHONE_OTP_GLOBAL_RATE_LIMIT_POINTS=1000
PHONE_VERIFICATION_GRANT_TTL_SECONDS=300
SMS_PROVIDER_CATEGORY=
SMS_PROVIDER_BASE_URL=
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_SENDER=
SMS_PROVIDER_TEMPLATE=
SMS_PROVIDER_TIMEOUT_MS=5000
SMS_SUPPORTED_REGIONS=
ACCOUNT_COMMAND_RETENTION_DAYS=30
GOOGLE_OAUTH_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URIS=
WECHAT_OAUTH_ENABLED=false
WECHAT_OAUTH_CLIENT_ID=
WECHAT_OAUTH_CLIENT_SECRET=
WECHAT_OAUTH_REDIRECT_URIS=

REALTIME_ENABLED=false
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_TOKEN_TTL_SECONDS=300
REDIS_URL=redis://127.0.0.1:6379
SOCIAL_PRESENCE_TTL_SECONDS=90

# AI expression assistance is disabled until provider policy and credentials are configured.
ASSISTANCE_ENABLED=false
ASSISTANCE_AUDIO_ENABLED=false
ASSISTANCE_NOTICE_VERSION=2026-09-v1
ASSISTANCE_OUTPUT_TTL_SECONDS=86400
ASSISTANCE_LEASE_SECONDS=30
ASSISTANCE_RATE_LIMIT_POINTS=10
ASSISTANCE_RATE_LIMIT_DURATION_SECONDS=60
ASSISTANCE_MAX_CONCURRENT=2
ASSISTANCE_USER_DAILY_REQUESTS=100
ASSISTANCE_USER_DAILY_AUDIO_SECONDS=600
ASSISTANCE_PLATFORM_DAILY_UNITS=100000
AI_EXPRESSION_PROVIDER_CATEGORY=
AI_EXPRESSION_BASE_URL=
AI_EXPRESSION_API_KEY=
AI_EXPRESSION_MODEL=
AI_EXPRESSION_TIMEOUT_MS=10000
AI_EXPRESSION_REGION=
AI_EXPRESSION_DATA_USE=
AI_EXPRESSION_RETENTION_SECONDS=0
AI_EXPRESSION_NO_TRAINING=false
STT_PROVIDER_CATEGORY=
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=
STT_TIMEOUT_MS=15000
STT_REGION=
STT_DATA_USE=
STT_RETENTION_SECONDS=0
STT_DELETION_MODE=
STT_STREAMING_MODE=

# Room speech detection is disabled until LiveKit and streaming STT are proven.
ROOM_SPEECH_DETECTION_ENABLED=false
ROOM_SPEECH_NOTICE_VERSION=2026-09-v1
ROOM_SPEECH_RULE_SET_VERSION=2026-09-v1
ROOM_SPEECH_HASH_SECRET=replace-with-at-least-32-characters
ROOM_SPEECH_LEASE_SECONDS=30
ROOM_SPEECH_WINDOW_MS=3000
ROOM_SPEECH_MAX_BUFFER_BYTES=512000
ROOM_SPEECH_MAX_ROOM_BUFFER_BYTES=2048000
ROOM_SPEECH_SILENCE_MS=1500
ROOM_SPEECH_ALERT_TTL_SECONDS=600
ROOM_SPEECH_RETENTION_DAYS=90

# Post-room keywords are disabled until the shared room-speech pipeline is proven.
POST_ROOM_KEYWORDS_ENABLED=false
POST_ROOM_KEYWORDS_NOTICE_VERSION=2026-09-v1
POST_ROOM_KEYWORDS_EXTRACTOR_VERSION=2026-09-v1
POST_ROOM_KEYWORDS_MAX_KEYWORDS=20
POST_ROOM_KEYWORDS_MAX_EXPRESSIONS=10
POST_ROOM_KEYWORDS_CANDIDATE_TTL_SECONDS=14400
POST_ROOM_KEYWORDS_JOB_LEASE_SECONDS=30
POST_ROOM_KEYWORDS_JOB_DEADLINE_SECONDS=600
POST_ROOM_KEYWORDS_COMMAND_RETENTION_DAYS=30

# Operations and data-governance runners are disabled until policies and target evidence are ready.
OPERATIONS_GOVERNANCE_ENABLED=false
OPERATIONS_METRIC_DEFINITION_VERSION=2026-09-v1
OPERATIONS_METRIC_MIN_SAMPLE=10
OPERATIONS_METRIC_FRESHNESS_SECONDS=172800
OPERATIONS_METRIC_LEASE_SECONDS=60
OPERATIONS_INCIDENT_FAILURE_THRESHOLD=3
OPERATIONS_INCIDENT_COOLDOWN_SECONDS=300
OPERATIONS_ALERT_SINK_URL=
OPERATIONS_ALERT_SINK_TOKEN=
OPERATIONS_ALERT_TIMEOUT_MS=5000
GOVERNANCE_RETENTION_BATCH_SIZE=100
GOVERNANCE_DRY_RUN_TTL_SECONDS=3600
GOVERNANCE_LEASE_SECONDS=60
GOVERNANCE_TECHNICAL_RETENTION_DAYS=30
BACKUP_ENVIRONMENT_ID=
BACKUP_ENCRYPTION_KEY_ID=
BACKUP_RETENTION_COUNT=
BACKUP_RPO_SECONDS=
BACKUP_RTO_SECONDS=
