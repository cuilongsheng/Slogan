APP_NAME=slogan-api
APP_PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://slogan:slogan@127.0.0.1:5432/slogan
CORS_ALLOWED_ORIGINS=http://localhost:5173
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_ISSUER=slogan-api
JWT_AUDIENCE=slogan-clients
REFRESH_TOKEN_PEPPER=replace-with-a-different-32-character-secret
REFRESH_TOKEN_TTL_SECONDS=2592000
ROOM_PASSWORD_PEPPER=replace-with-another-random-32-character-secret
ROOM_RULES_VERSION=2026-09-v1
AUTH_RATE_LIMIT_POINTS=10
AUTH_RATE_LIMIT_DURATION_SECONDS=60
OAUTH_HTTP_TIMEOUT_MS=5000
GOOGLE_OAUTH_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URIS=
WECHAT_OAUTH_ENABLED=false
WECHAT_OAUTH_CLIENT_ID=
WECHAT_OAUTH_CLIENT_SECRET=
WECHAT_OAUTH_REDIRECT_URIS=
