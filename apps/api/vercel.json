{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/realtime.ts": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "slogan-realtime"
        }
      ]
    },
    "api/maintenance.ts": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "slogan-maintenance"
        }
      ],
      "maxDuration": 300
    },
    "api/live-updates.ts": {
      "maxDuration": 300,
      "supportsCancellation": true
    },
    "api/observability.ts": {
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "slogan-observability"
        }
      ]
    }
  },
  "crons": [
    {
      "path": "/api/maintenance-seed",
      "schedule": "0 0 * * *"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": false,
      "codex/merge-reviewed-v1-20261016": false
    }
  },
  "rewrites": [
    {
      "source": "/v1/me/live-updates",
      "destination": "/api/live-updates"
    }
  ]
}
