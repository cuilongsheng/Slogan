model VocabularyCommand {
  id              String                  @id @default(uuid()) @db.Uuid
  userId          String                  @db.Uuid
  clientRequestId String                  @db.Uuid
  action          VocabularyCommandAction
  payloadHash     String                  @db.Char(64)
  resultItemId    String?                 @db.Uuid
  createdAt       DateTime                @default(now()) @db.Timestamptz(3)
  user            User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  resultItem      VocabularyItem?         @relation(fields: [resultItemId], references: [id], onDelete: SetNull)

  @@unique([userId, clientRequestId])
  @@index([createdAt, id])
}
