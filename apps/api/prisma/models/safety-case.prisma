model SafetyCase {
  id               String                          @id @default(uuid()) @db.Uuid
  reportId         String                          @unique @db.Uuid
  roomId           String                          @db.Uuid
  targetUserId     String                          @db.Uuid
  status           SafetyCaseStatus                @default(OPEN)
  assigneeUserId   String?                         @db.Uuid
  assignedAt       DateTime?                       @db.Timestamptz(3)
  reviewStartedAt  DateTime?                       @db.Timestamptz(3)
  assessedSeverity SafetySeverity?
  decisionType     SafetyDecisionType?
  decisionReason   String?                         @db.VarChar(500)
  decidedAt        DateTime?                       @db.Timestamptz(3)
  version          Int                             @default(1)
  createdAt        DateTime                        @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime                        @updatedAt @db.Timestamptz(3)
  report           Report                          @relation(fields: [reportId], references: [id], onDelete: Restrict)
  room             Room                            @relation(fields: [roomId], references: [id], onDelete: Restrict)
  target           User                            @relation("SafetyCaseTarget", fields: [targetUserId], references: [id], onDelete: Restrict)
  assignee         User?                           @relation("SafetyCaseAssignee", fields: [assigneeUserId], references: [id], onDelete: Restrict)
  participants     SafetyCaseParticipantSnapshot[]
  activities       SafetyCaseActivity[]
  restriction      SafetyRestriction?

  @@index([status, createdAt, id])
  @@index([assigneeUserId, status, createdAt, id])
  @@index([targetUserId, createdAt, id])
  @@index([roomId, createdAt, id])
}
