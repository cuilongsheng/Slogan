model MetricComputationRun {
  id                String          @id @default(uuid()) @db.Uuid
  grain             MetricGrain
  windowStart       DateTime        @db.Timestamptz(3)
  windowEnd         DateTime        @db.Timestamptz(3)
  definitionVersion String          @db.VarChar(64)
  status            MetricRunStatus @default(PENDING)
  generation        Int             @default(0)
  leaseId           String?         @db.Uuid
  lockedUntil       DateTime?       @db.Timestamptz(3)
  watermark         DateTime?       @db.Timestamptz(3)
  errorCode         String?         @db.VarChar(64)
  startedAt         DateTime?       @db.Timestamptz(3)
  completedAt       DateTime?       @db.Timestamptz(3)
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @db.Timestamptz(3)
  snapshots         MetricSnapshot[]

  @@unique([grain, windowStart, windowEnd, definitionVersion])
  @@index([status, lockedUntil, windowStart])
}
