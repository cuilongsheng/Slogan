model UserBlock {
  id            String    @id @db.Uuid
  blockerUserId String    @db.Uuid
  blockedUserId String    @db.Uuid
  unblockedAt   DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)
  blocker       User      @relation("UserBlockCreator", fields: [blockerUserId], references: [id], onDelete: Restrict)
  blocked       User      @relation("UserBlockTarget", fields: [blockedUserId], references: [id], onDelete: Restrict)

  @@unique([blockerUserId, blockedUserId])
  @@index([blockerUserId, unblockedAt, createdAt, id])
  @@index([blockedUserId, unblockedAt])
}
