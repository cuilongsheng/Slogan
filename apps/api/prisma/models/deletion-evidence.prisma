model DeletionEvidence {
  id               String                 @id @default(uuid()) @db.Uuid
  category         RetentionDataCategory
  purpose          String                 @db.VarChar(64)
  providerCategory String?                @db.VarChar(64)
  policyVersion    String                 @db.VarChar(64)
  deadlineAt       DateTime               @db.Timestamptz(3)
  completedAt      DateTime?              @db.Timestamptz(3)
  result           DeletionEvidenceResult
  reasonCode       String?                @db.VarChar(64)
  createdAt        DateTime               @default(now()) @db.Timestamptz(3)

  @@index([result, deadlineAt, id])
  @@index([category, createdAt, id])
}
