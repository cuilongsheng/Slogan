model RecoveryDrill {
  id                 String                   @id @default(uuid()) @db.Uuid
  actorUserId        String                   @db.Uuid
  clientRequestId    String                   @db.Uuid
  payloadHash        String                   @db.Char(64)
  environment        RecoveryDrillEnvironment
  environmentId      String                   @db.VarChar(64)
  backupDigest       String                   @db.Char(64)
  toolVersion        String                   @db.VarChar(64)
  schemaVersion      String                   @db.VarChar(128)
  status             RecoveryDrillStatus      @default(RUNNING)
  observedRpoSeconds Int?
  observedRtoSeconds Int?
  checkSummary       Json
  errorCode          String?                  @db.VarChar(64)
  startedAt          DateTime                 @db.Timestamptz(3)
  completedAt        DateTime?                @db.Timestamptz(3)
  createdAt          DateTime                 @default(now()) @db.Timestamptz(3)

  @@unique([actorUserId, clientRequestId])
  @@index([environment, startedAt, id])
}
