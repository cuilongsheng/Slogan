model RoomKeywordSummary {
  id                String                   @id @default(uuid()) @db.Uuid
  roomId            String                   @unique @db.Uuid
  status            RoomKeywordSummaryStatus @default(COLLECTING)
  topicSnapshot     String                   @db.VarChar(120)
  extractorVersion  String                   @db.VarChar(64)
  failureCategory   String?                  @db.VarChar(64)
  failureObservedAt DateTime?                @db.Timestamptz(3)
  generatedAt       DateTime?                @db.Timestamptz(3)
  version           Int                      @default(1)
  createdAt         DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                 @updatedAt @db.Timestamptz(3)
  room              Room                     @relation(fields: [roomId], references: [id], onDelete: Restrict)
  items             RoomKeywordSummaryItem[]
  job               RoomKeywordSummaryJob?

  @@index([status, updatedAt, id])
}
