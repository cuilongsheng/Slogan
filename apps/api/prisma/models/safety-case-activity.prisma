model SafetyCaseActivity {
  id             String                  @id @default(uuid()) @db.Uuid
  caseId         String                  @db.Uuid
  type           SafetyCaseActivityType
  actorType      SafetyActivityActorType
  actorUserId    String?                 @db.Uuid
  fromStatus     SafetyCaseStatus?
  toStatus       SafetyCaseStatus?
  assigneeUserId String?                 @db.Uuid
  reason         String?                 @db.VarChar(500)
  occurredAt     DateTime                @default(now()) @db.Timestamptz(3)
  safetyCase     SafetyCase              @relation(fields: [caseId], references: [id], onDelete: Cascade)
  actor          User?                   @relation("SafetyActivityActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([caseId, occurredAt, id])
}
