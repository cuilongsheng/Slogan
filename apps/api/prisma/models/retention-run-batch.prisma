model RetentionRunBatch {
  id           String       @id @default(uuid()) @db.Uuid
  runId        String       @db.Uuid
  generation   Int
  sequence     Int
  cursorAt     DateTime?    @db.Timestamptz(3)
  cursorId     String?      @db.VarChar(128)
  scannedCount Int
  deletedCount Int
  skippedCount Int
  failedCount  Int
  committedAt  DateTime     @default(now()) @db.Timestamptz(3)
  run          RetentionRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, generation, sequence])
  @@index([runId, committedAt])
}
