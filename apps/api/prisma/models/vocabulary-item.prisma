model VocabularyItem {
  id                  String                 @id @default(uuid()) @db.Uuid
  userId              String                 @db.Uuid
  kind                RoomKeywordItemKind
  displayText         String                 @db.VarChar(120)
  normalizedText      String                 @db.VarChar(120)
  note                String?                @db.VarChar(500)
  favorite            Boolean                @default(false)
  version             Int                    @default(1)
  sourceSummaryItemId String                 @db.Uuid
  createdAt           DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime               @updatedAt @db.Timestamptz(3)
  user                User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  sourceSummaryItem   RoomKeywordSummaryItem @relation(fields: [sourceSummaryItemId], references: [id], onDelete: Restrict)
  resultCommands      VocabularyCommand[]

  @@unique([userId, sourceSummaryItemId])
  @@index([userId, updatedAt, id])
  @@index([userId, favorite, kind, updatedAt, id])
}
