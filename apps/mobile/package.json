{
  "name": "@slogan/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build": "expo export --platform ios --output-dir dist",
    "lint": "eslint app src --max-warnings=0",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "expo": "57.0.21",
    "expo-constants": "57.0.17",
    "expo-linking": "57.0.9",
    "expo-router": "57.0.20",
    "expo-status-bar": "57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@react-native/metro-config": "0.86.3",
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.18",
    "jest": "29.7.0",
    "jest-expo": "57.0.5",
    "react-test-renderer": "19.2.3",
    "typescript": "6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/src/**/*.spec.ts?(x)"
    ]
  }
}
