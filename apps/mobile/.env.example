# Public app configuration. Use the API origin reachable by the device.
EXPO_PUBLIC_API_BASE_URL=
# OAuth client ID of type Web application; matches API GOOGLE_OAUTH_CLIENT_ID.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# OAuth client ID of type iOS; needed for the native iOS URL scheme.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Optional local Xcode signing team; kept outside the public Expo config.
EXPO_APPLE_TEAM_ID=
